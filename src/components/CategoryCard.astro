---
import type { Category } from '../lib/categories';
import { withBase } from '../lib/url';

interface Props {
  category: Category;
  count?: number;
}
const { category, count } = Astro.props;
---

<a
  href={withBase(`/manual/${category.id}`)}
  class="group relative flex flex-col overflow-hidden rounded-lg border border-line bg-surface p-5 transition hover:-translate-x-1 hover:-translate-y-1 hover:border-guards/60 hover:shadow-[6px_6px_0_var(--color-hot)]"
>
  <span class="stripe-neon absolute inset-x-0 top-0 h-[3px] origin-left scale-x-0 transition-transform duration-300 group-hover:scale-x-100"></span>
  <div class="flex items-center justify-between">
    <span class="grid h-12 w-12 place-items-center rounded-lg bg-guards/10 text-guards transition group-hover:bg-guards group-hover:text-carbon">
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={category.icon} /></svg>
    </span>
    {count !== undefined && (
      <span class="rounded-full border border-line px-2.5 py-1 font-mono text-[0.62rem] font-bold uppercase tracking-wider text-ink-soft">{count} {count === 1 ? 'article' : 'articles'}</span>
    )}
  </div>
  <h3 class="mt-4 font-display text-xl font-bold uppercase tracking-wide text-ink">{category.name}</h3>
  <p class="mt-1 text-sm leading-relaxed text-ink-soft/85">{category.blurb}</p>
  <span class="mt-4 inline-flex items-center gap-1 font-mono text-[0.68rem] font-bold uppercase tracking-[0.2em] text-guards">
    Browse
    <svg class="h-4 w-4 transition group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
  </span>
</a>
