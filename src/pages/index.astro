---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
import CategoryCard from '../components/CategoryCard.astro';
import AttributionBadge from '../components/AttributionBadge.astro';
import { MANUAL_CATEGORIES, EXTRA_CATEGORIES } from '../lib/categories';
import { getCategoryCounts, getArticles } from '../lib/content';
import { SITE } from '../lib/site';

const counts = await getCategoryCounts();
const total = Object.values(counts).reduce((a, b) => a + b, 0);
const all = await getArticles();
const recent = all
  .filter((a) => a.data.updated)
  .sort((a, b) => (b.data.updated?.getTime() ?? 0) - (a.data.updated?.getTime() ?? 0))
  .slice(0, 6);
---

<BaseLayout bare>
  <!-- ── Hero ─────────────────────────────────────────── -->
  <section class="relative overflow-hidden bg-carbon-grid text-white">
    <div class="absolute -right-40 -top-40 h-[28rem] w-[28rem] rounded-full border border-guards/15" aria-hidden="true"></div>
    <div class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-guards/15 blur-3xl" aria-hidden="true"></div>
    <div class="absolute -left-24 bottom-0 h-72 w-72 rounded-full bg-hot/10 blur-3xl" aria-hidden="true"></div>
    <div class="outrun-floor pointer-events-none absolute inset-x-[-25%] bottom-0 h-56" aria-hidden="true"></div>
    <div class="stripe-neon absolute inset-x-0 bottom-0 h-[3px]" aria-hidden="true"></div>

    <div class="relative mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-12 lg:px-8 lg:py-28">
      <div class="lg:col-span-7">
        <p class="kicker flex items-center gap-3">
          <span class="h-px w-10 bg-guards"></span>
          Open source · Sponsored by {SITE.sponsor.name}
        </p>
        <h1 class="mt-6 font-display text-5xl font-bold leading-[0.95] sm:text-7xl">
          <span class="text-chroma block">Porsche&nbsp;944</span>
          <span class="text-outline block">Repair manual</span>
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-white/70">
          A free, community-driven knowledge base for the 944, 944 Turbo, 924S and 968 —
          preserving proven wrenching wisdom and making it searchable, modern and open.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a href="#manual" class="rounded-md bg-guards px-6 py-3.5 font-mono text-xs font-bold uppercase tracking-[0.2em] text-carbon hover:bg-guards-light">
            Browse the manual →
          </a>
          <a href={withBase('/search')} class="rounded-md border border-white/40 px-6 py-3.5 font-mono text-xs font-bold uppercase tracking-[0.2em] text-white/90 transition hover:border-hot hover:text-hot-light">
            Search articles
          </a>
        </div>
        <dl class="mt-12 flex gap-10">
          <div>
            <dt class="font-display text-4xl font-bold text-hot [text-shadow:0_0_18px_rgba(255,62,165,0.45)]">{total}</dt>
            <dd class="mt-1 font-mono text-[0.62rem] uppercase tracking-[0.22em] text-white/50">Articles</dd>
          </div>
          <div>
            <dt class="font-display text-4xl font-bold text-guards [text-shadow:0_0_18px_rgba(19,165,220,0.45)]">6</dt>
            <dd class="mt-1 font-mono text-[0.62rem] uppercase tracking-[0.22em] text-white/50">Core systems</dd>
          </div>
          <div>
            <dt class="font-display text-4xl font-bold text-white">100%</dt>
            <dd class="mt-1 font-mono text-[0.62rem] uppercase tracking-[0.22em] text-white/50">Free &amp; open</dd>
          </div>
        </dl>
      </div>

      <!-- Attribution explainer card -->
      <div class="lg:col-span-5 lg:pt-10">
        <div class="relative border border-line bg-carbon/85 p-6 shadow-[8px_8px_0_var(--color-hot)] backdrop-blur">
          <span class="absolute inset-x-0 top-0 h-[3px] bg-guards" aria-hidden="true"></span>
          <h2 class="kicker">Every article is credited</h2>
          <p class="mt-3 text-sm text-white/65">
            We preserve the original authorship. Look for the small mark on each guide:
          </p>
          <ul class="mt-5 space-y-4">
            <li class="flex items-start gap-3">
              <AttributionBadge author="CG" size="md" />
              <span class="text-sm text-white/70"><strong class="text-white">Clark's Garage</strong> — legacy reference material, ported with credit.</span>
            </li>
            <li class="flex items-start gap-3">
              <AttributionBadge author="FFP" size="md" />
              <span class="text-sm text-white/70"><strong class="text-white">FormFactor Performance</strong> — original content &amp; upgrades.</span>
            </li>
            <li class="flex items-start gap-3">
              <AttributionBadge author="community" size="md" />
              <span class="text-sm text-white/70"><strong class="text-white">Community</strong> — contributions from 944 owners like you.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Shop manual grid ─────────────────────────────── -->
  <section id="manual" class="mx-auto max-w-7xl scroll-mt-20 px-4 py-20 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between gap-4">
      <div class="flex items-end gap-5">
        <span class="text-outline-dim font-display text-7xl font-bold leading-[0.8] sm:text-8xl" aria-hidden="true">01</span>
        <div>
          <p class="kicker">Shop Manual</p>
          <h2 class="mt-1 font-display text-3xl font-bold text-ink sm:text-4xl">Six core systems</h2>
        </div>
      </div>
      <a href={withBase('/search')} class="hidden font-mono text-[0.68rem] font-bold uppercase tracking-[0.2em] text-ink-soft hover:text-guards-light sm:block">All articles →</a>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {MANUAL_CATEGORIES.map((c) => <CategoryCard category={c} count={counts[c.id] ?? 0} />)}
    </div>
  </section>

  <!-- ── Beyond the manual ────────────────────────────── -->
  <section class="border-y border-line bg-surface/80">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="flex items-end gap-5">
        <span class="text-outline-dim font-display text-7xl font-bold leading-[0.8] sm:text-8xl" aria-hidden="true">02</span>
        <div>
          <p class="kicker">Beyond the Manual</p>
          <h2 class="mt-1 font-display text-3xl font-bold text-ink sm:text-4xl">More than repair steps</h2>
        </div>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-3">
        {EXTRA_CATEGORIES.map((c) => <CategoryCard category={c} count={counts[c.id] ?? 0} />)}
      </div>
    </div>
  </section>

  <!-- ── Recently updated ─────────────────────────────── -->
  {recent.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="flex items-end gap-5">
        <span class="text-outline-dim font-display text-7xl font-bold leading-[0.8] sm:text-8xl" aria-hidden="true">03</span>
        <div>
          <p class="kicker">Fresh</p>
          <h2 class="mt-1 font-display text-3xl font-bold text-ink sm:text-4xl">Recently updated</h2>
        </div>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {recent.map((a) => (
          <a href={withBase(`/manual/${a.data.category}/${a.id.split('/').pop()}`)} class="group rounded-lg border border-line bg-surface p-4 transition hover:-translate-x-0.5 hover:-translate-y-0.5 hover:border-guards/60 hover:shadow-[4px_4px_0_var(--color-hot)]">
            <div class="flex items-center gap-2">
              <AttributionBadge author={a.data.author} authorName={a.data.authorName} />
            </div>
            <h3 class="mt-2 font-semibold text-ink group-hover:text-guards-light">{a.data.title}</h3>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- ── Sponsor / CTA band ───────────────────────────── -->
  <section class="relative bg-carbon-grid">
    <div class="stripe-neon absolute inset-x-0 top-0 h-[3px]" aria-hidden="true"></div>
    <div class="mx-auto flex max-w-7xl flex-col items-start gap-6 px-4 py-14 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
      <div>
        <h2 class="text-chroma-sm font-display text-3xl font-bold text-white">Know something we don't?</h2>
        <p class="mt-2 max-w-xl text-white/60">944 Hub is open source. Add an article, fix a torque spec, or share a write-up — every contribution is credited to you.</p>
      </div>
      <div class="flex gap-3">
        <a href={withBase('/contribute')} class="rounded-md bg-guards px-5 py-3 font-mono text-xs font-bold uppercase tracking-[0.2em] text-carbon hover:bg-guards-light">Contribute</a>
        <a href={SITE.github} class="rounded-md border border-white/40 px-5 py-3 font-mono text-xs font-bold uppercase tracking-[0.2em] text-white/90 transition hover:border-hot hover:text-hot-light">View on GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>
